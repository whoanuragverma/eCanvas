{
  "name": "@repo/schema",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./hook": "./src/hook.ts",
    "./component": "./src/component.ts",
    "./json": "./dist/schema.json"
  },
  "scripts": {
    "dev": "watch 'npm run build && tsc' src",
    "build": "ts-json-schema-generator --path 'src/index.ts' --no-type-check --out 'dist/schema.json' && tsc"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@turbo/gen": "^1.12.4",
    "@types/eslint": "^8.56.5",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "eslint": "^8.57.0",
    "typescript": "5.5.4",
    "watch": "^1.0.2"
  },
  "dependencies": {
    "ts-json-schema-generator": "^2.3.0"
  }
}
